# ---------------------------------------------------------------------------
# Conexao com o Baserow
# ---------------------------------------------------------------------------
# NAO coloque segredos aqui. Este arquivo e so o modelo: copie para .env.
# Baserow em nuvem:    https://api.baserow.io
# Baserow self-hosted: https://seu-servidor
BASEROW_URL=https://api.baserow.io

# Credenciais do usuario Baserow (usadas para ler o esquema e criar campos)
BASEROW_EMAIL=
BASEROW_PASSWORD=

# Opcional: token de banco de dados (Settings > Database tokens).
# Se informado, e usado para ler/gravar linhas no lugar do JWT.
BASEROW_TOKEN=

# Opcional: IDs das tabelas. Se ficarem em branco, o app descobre pelo nome.
BASEROW_DATABASE_ID=
TABLE_UNIDADES=
TABLE_FUNCIONARIOS=
TABLE_USUARIOS=
TABLE_LANCAMENTOS=

# ---------------------------------------------------------------------------
# Aplicacao
# ---------------------------------------------------------------------------
SECRET_KEY=troque-esta-chave-por-uma-aleatoria
JORNADA_PADRAO_HORAS=8
# Almoco que nao conta como hora excedente, salvo hora corrida autorizada
ALMOCO_HORAS=1
TIMEZONE_OFFSET=-3
